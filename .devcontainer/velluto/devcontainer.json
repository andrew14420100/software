{
  "name": "Velluto (streaming demo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/velluto",
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends ffmpeg && npm ci",
  "postCreateCommand": "bash .devcontainer-start.sh setup",
  "postStartCommand": "bash .devcontainer-start.sh start",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Velluto", "onAutoForward": "openBrowser" } },
  "remoteEnv": { "VELLUTO_SOURCES": "/workspaces/velluto-cache", "VELLUTO_INSECURE_COOKIES": "0" }
}
